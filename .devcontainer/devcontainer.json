{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "postStartCommand": "sudo chown -R vscode:vscode /workspaces; sudo /usr/local/share/docker-init.sh; npm install; pre-commit install --install-hooks",
    "mounts": [
        "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
        "source=${localWorkspaceFolderBasename}-containerd,target=/var/lib/containerd,type=volume"
    ],
    "remoteEnv": {
        "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": ["*/devcontainer-feature.json"],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    }
                ]
            },
            "extensions": []
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "moby": false
        },
        "ghcr.io/doughom/features/actionlint:1.7.12": {},
        "ghcr.io/doughom/features/hadolint:2.15.1": {},
        "ghcr.io/doughom/features/pre-commit:1": {},
        "ghcr.io/doughom/features/prettier:1": {},
        "ghcr.io/doughom/features/shellcheck:0.11.0": {},
        "ghcr.io/doughom/features/shfmt:3.14.1": {}
    },
    "remoteUser": "vscode"
}
